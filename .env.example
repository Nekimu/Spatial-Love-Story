# ==============================================================================
# .env.example · Plantilla de Variables de Entorno
# Copia este archivo como `.env` y coloca tus credenciales reales.
# ==============================================================================

# 1. Credenciales OAuth 2.0 / Proyecto de Google Cloud
GOOGLE_PROJECT_ID=tu-proyecto-drive-api
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-tu-client-secret
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# 2. API Key (para lectura directa de carpetas públicas sin login)
GOOGLE_DRIVE_API_KEY=AIzaSy_TU_API_KEY_AQUI

# 3. Enlace o ID de la Carpeta Raíz en Google Drive
GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/TU_FOLDER_ID_AQUI
GOOGLE_DRIVE_MODE=reemplazar
GOOGLE_DRIVE_CACHE_MINUTES=5

# Opcional: carpetas individuales por capítulo
GOOGLE_DRIVE_FOLDER_EPILOGO=
GOOGLE_DRIVE_FOLDER_CAP_1=
GOOGLE_DRIVE_FOLDER_CAP_2=
GOOGLE_DRIVE_FOLDER_CAP_3=
GOOGLE_DRIVE_FOLDER_CAP_4=

# Opcional: nombres privados fuera del repositorio público
BRAND_SUBTITLE=
COUPLE_NAME_EL=
COUPLE_NAME_ELLA=
